#!/usr/bin/env bash
# Converge this Target to its Intent (.claude/claude-config.json), or check it.
# Usage: .claude/scripts/apply [--check]   (from anywhere; the Target is found from this script's location)
#   (no flag)  converge: write the owned untracked state the Intent asks for.
#   --check    read-only: report drift between the Target and its Intent, and between
#              the installed Payload and the Manifest stamp; writes nothing.
# Report: one stdout line per action, "<done|skipped|drift> <concern>: <detail>".
#   Check mode prints only drift lines, then — when converging would cure any of them —
#   "drift target: run /apply-claude-config to converge". A clean Target prints nothing.
# Exit (converge): 0 converged or nothing to do (no Intent included); 1 failure.
# Exit (--check):  0 clean; 1 failure; 2 drift; 3 no Intent (pointer to Setup printed).
# Errors go to stderr.
#
# Intent keys (a JSON object; absent keys take their default):
#   stalenessHook  boolean, default true — a SessionStart hook in .claude/settings.local.json
#                  running "apply --check" via $CLAUDE_PROJECT_DIR; false removes it.
#   gitHooks       array of hook names, default [] — each shipped hook in
#                  .claude/scripts/git-hooks/ to arm, as a relative symlink in the repo's
#                  hooks dir (core.hooksPath honoured). A suite-owned link (one resolving
#                  into .claude/scripts/git-hooks/) that the list drops is removed; a
#                  foreign hook in a slot is never touched — Apply refuses and says so.
#   plugins        array of "<plugin>@<marketplace>" strings, default [] — plugins wanted
#                  at project scope. Split scope: the enabledPlugins entry in the
#                  (possibly tracked) .claude/settings.json is shared; the plugin cache
#                  lives in each environment's ${CLAUDE_CONFIG_DIR:-~/.claude}, so each
#                  environment's own Apply run converges its cache. Apply installs via
#                  "claude plugin install --scope project" (which writes the entry),
#                  skipping with a reason when the CLI isn't on PATH. Enabled plugins the
#                  Intent doesn't list are reported for manual removal, never uninstalled.
set -euo pipefail

usage() {
  echo "Usage: $0 [--check]" >&2
  exit 1
}

mode=converge
case $# in
  0) ;;
  1) [ "$1" = --check ] || usage; mode=check ;;
  *) usage ;;
esac

# Resolved fresh on every run, never persisted: Host and Sandbox mount the
# Target at different absolute paths (ADR-0009).
here="$(cd "$(dirname "$0")" && pwd)"
if [ "$(basename "$here")" != scripts ] || [ "$(basename "$(dirname "$here")")" != .claude ]; then
  echo "Error: run Apply from a Target's .claude/scripts/, not $here" >&2
  exit 1
fi
TARGET="$(cd "$here/../.." && pwd)"
INTENT="$TARGET/.claude/claude-config.json"
SETTINGS="$TARGET/.claude/settings.local.json"
MANIFEST="$TARGET/.claude/.claude-config-manifest"

report() { # report <done|skipped|drift> <concern> <detail>
  printf '%s %s: %s\n' "$1" "$2" "$3"
}

die() {
  echo "Error: $*" >&2
  exit 1
}

# drift <concern> <detail> — check mode: report drift that converging cures.
drifted=0
drift() {
  report drift "$1" "$2"
  drifted=1
}
# Check mode: set by drift reported directly (report drift ...) because converging
# can't cure it; it still makes the check exit 2, without the skill suggestion.
stale=0

# drift_manual <concern> <detail> — check mode: report drift converging won't cure
# (the detail says what the user must do); exits 2 without suggesting the skill.
manual=0
drift_manual() {
  report drift "$1" "$2"
  manual=1
}

# intent_bool <key> <default> — the Intent's boolean at top-level <key>.
intent_bool() {
  jq -r --arg k "$1" --argjson d "$2" '
    if has($k) then (if (.[$k] | type) == "boolean" then .[$k] else error("not a boolean") end)
    else $d end' "$INTENT" 2>/dev/null || die "Intent key $1 must be true or false"
}

# Settings: Apply owns a fixed set of keys in the untracked settings.local.json;
# everything else in the file is left as it is. The file is rewritten only when a
# converge step changes something, so a converged file stays byte-identical.
settings_json() {
  if [ -f "$SETTINGS" ]; then
    jq -c . "$SETTINGS" 2>/dev/null || die "cannot read $SETTINGS: not valid JSON"
  else
    echo '{}'
  fi
}

settings_write() { # settings_write <json>
  local pretty
  pretty="$(jq . <<<"$1")"
  printf '%s\n' "$pretty" > "$SETTINGS"
}

# Each concern <c> has converge_<c> (writes, reports done/skipped) and check_<c>
# (read-only, calls drift). Both read $INTENT. Steps run in order.
steps=(staleness_hook git_hooks plugins)

# --- staleness-hook -----------------------------------------------------------
# Owned entry: the SessionStart hook whose command is exactly HOOK_CMD. The
# hooks-documented project-dir variable keeps absolute paths out of settings,
# and "|| true" keeps the session unblocked: stdout reaches the session context.
HOOK_CMD='"$CLAUDE_PROJECT_DIR"/.claude/scripts/apply --check || true'

hook_present() { # hook_present <settings-json>
  jq -e --arg cmd "$HOOK_CMD" 'any(.hooks.SessionStart[]?.hooks[]?; .command == $cmd)' <<<"$1" >/dev/null
}

converge_staleness_hook() {
  local on current
  on="$(intent_bool stalenessHook true)"
  current="$(settings_json)"
  if [ "$on" = true ]; then
    if hook_present "$current"; then
      report skipped staleness-hook "already in place"
    else
      settings_write "$(jq -c --arg cmd "$HOOK_CMD" \
        '.hooks.SessionStart += [{hooks: [{type: "command", command: $cmd}]}]' <<<"$current")"
      report done staleness-hook "SessionStart check added to .claude/settings.local.json"
    fi
  elif hook_present "$current"; then
    # Remove only the owned command; drop containers only if that emptied them.
    settings_write "$(jq -c --arg cmd "$HOOK_CMD" '
      .hooks.SessionStart |= map(
        if any(.hooks[]?; .command == $cmd)
        then (.hooks |= map(select(.command != $cmd))) | select(.hooks | length > 0)
        else . end)
      | if (.hooks.SessionStart | length) == 0 then del(.hooks.SessionStart) else . end
      | if (.hooks | length) == 0 then del(.hooks) else . end' <<<"$current")"
    report done staleness-hook "SessionStart check removed (disabled in Intent)"
  else
    report skipped staleness-hook "disabled in Intent"
  fi
}

check_staleness_hook() {
  local on current
  on="$(intent_bool stalenessHook true)"
  current="$(settings_json)"
  if [ "$on" = true ] && ! hook_present "$current"; then
    drift staleness-hook "SessionStart check missing from .claude/settings.local.json"
  elif [ "$on" = false ] && hook_present "$current"; then
    drift staleness-hook "SessionStart check present but disabled in Intent"
  fi
}

# --- plugins --------------------------------------------------------------------
# Apply never writes .claude/settings.json itself: the plugin CLI does, run from the
# Target so --scope project lands there. Installed = entry enabled and cached here.
PROJECT_SETTINGS="$TARGET/.claude/settings.json"
PLUGIN_CACHE="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/plugins/cache"

intent_plugins() { # one "<plugin>@<marketplace>" per line
  jq -r '(.plugins // []) | if type == "array" and all(type == "string" and test("^[^@\\s]+@[^@\\s]+$"))
    then .[] else error("bad plugins") end' "$INTENT" 2>/dev/null \
    || die 'Intent key plugins must be an array of "<plugin>@<marketplace>" strings'
}

enabled_plugins() { # project-scope plugins enabled in .claude/settings.json, one per line
  [ -f "$PROJECT_SETTINGS" ] || return 0
  jq -r '(.enabledPlugins // {}) | to_entries[] | select(.value == true) | .key' "$PROJECT_SETTINGS" 2>/dev/null \
    || die "cannot read $PROJECT_SETTINGS: not valid JSON"
}

plugin_cached() { # plugin_cached <plugin>@<marketplace>
  local p="$1"
  [ -n "$(ls -A "$PLUGIN_CACHE/${p#*@}/${p%@*}" 2>/dev/null)" ]
}

dropped_plugin_detail() { # dropped_plugin_detail <plugin>
  echo "$1 enabled in .claude/settings.json but not in the Intent; Apply never uninstalls — remove it by hand (claude plugin uninstall --scope project $1) or add it to the Intent"
}

# dropped_plugins <wanted> <enabled> — enabled plugins the Intent doesn't list.
dropped_plugins() {
  comm -13 <(LC_ALL=C sort -u <<<"$1") <(LC_ALL=C sort -u <<<"$2") | grep -v '^$' || true
}

converge_plugins() {
  local wanted enabled p was_enabled failed=0 missing=()
  wanted="$(intent_plugins)"
  enabled="$(enabled_plugins)"
  for p in $wanted; do
    if grep -Fxq -- "$p" <<<"$enabled" && plugin_cached "$p"; then
      report skipped plugins "$p already enabled in .claude/settings.json and cached in this environment"
    else
      missing+=("$p")
    fi
  done
  if [ "${#missing[@]}" -gt 0 ] && ! command -v claude >/dev/null; then
    report skipped plugins "claude CLI not on PATH; not installed in this environment: ${missing[*]}"
    missing=()
  fi
  for p in "${missing[@]}"; do
    was_enabled=0
    grep -Fxq -- "$p" <<<"$enabled" && was_enabled=1
    if ! (cd "$TARGET" && claude plugin install --scope project "$p") >/dev/null; then
      echo "Error: claude plugin install --scope project $p failed" >&2
      failed=1
    elif ! enabled_plugins | grep -Fxq -- "$p" || ! plugin_cached "$p"; then
      echo "Error: claude plugin install --scope project $p left it not enabled in .claude/settings.json or not cached" >&2
      failed=1
    elif [ "$was_enabled" -eq 1 ]; then
      report done plugins "$p cached in this environment (its entry was already in .claude/settings.json); each other environment caches it on its own Apply run"
    else
      report done plugins "$p enabled in .claude/settings.json (shared) and cached in this environment; each other environment caches it on its own Apply run"
    fi
  done
  while IFS= read -r p; do
    [ -n "$p" ] && report skipped plugins "$(dropped_plugin_detail "$p")"
  done <<<"$(dropped_plugins "$wanted" "$enabled")"
  [ "$failed" -eq 0 ] || die "plugin install failed (see above)"
}

check_plugins() {
  local wanted enabled p detail cli=1
  wanted="$(intent_plugins)"
  enabled="$(enabled_plugins)"
  command -v claude >/dev/null || cli=0
  for p in $wanted; do
    if ! grep -Fxq -- "$p" <<<"$enabled"; then
      detail="$p not enabled in .claude/settings.json"
    elif ! plugin_cached "$p"; then
      detail="$p enabled in .claude/settings.json but not cached in this environment"
    else
      continue
    fi
    if [ "$cli" -eq 1 ]; then
      drift plugins "$detail"
    else
      report drift plugins "$detail; claude CLI not on PATH, so Apply can't install it here"
      stale=1
    fi
  done
  # Manual removal only: drift, but converging doesn't cure it — no skill suggestion.
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    report drift plugins "$(dropped_plugin_detail "$p")"
    stale=1
  done <<<"$(dropped_plugins "$wanted" "$enabled")"
}

# --- git-hooks -------------------------------------------------------------------
# Ownership is stateless: a hooks-dir entry is the suite's when it is a symlink
# resolving into the Target's .claude/scripts/git-hooks/. Anything else in a slot is
# foreign and never modified. Links are relative, so they resolve wherever the
# Target is mounted (ADR-0009).

# intent_hooks — the Intent's gitHooks names, one per line, deduplicated.
intent_hooks() {
  jq -r 'if has("gitHooks") then .gitHooks else [] end
    | if type == "array" and all(.[]; type == "string" and test("^[a-z0-9][a-z0-9-]*$"))
      then unique[] else error("not an array of hook names") end' "$INTENT" 2>/dev/null \
    || die "Intent key gitHooks must be an array of hook names"
}

# hooks_locate — set HOOK_SRC (the installed hooks), HOOKS_DIR (the repo's hooks dir,
# core.hooksPath honoured; physical when it exists) and HOOKS_REL (HOOKS_DIR for
# reports, relative to the Target when inside it). Returns 1 outside a git repo.
hooks_locate() {
  local top dir
  top="$(cd "$TARGET" && pwd -P)"
  HOOK_SRC="$top/.claude/scripts/git-hooks"
  command -v git >/dev/null || return 1
  dir="$(cd "$TARGET" && git rev-parse --git-path hooks 2>/dev/null)" || return 1
  case $dir in /*) ;; *) dir="$top/$dir" ;; esac
  [ ! -d "$dir" ] || dir="$(cd "$dir" && pwd -P)"
  HOOKS_DIR="$dir"
  HOOKS_REL="${dir#"$top"/}"
}

relpath() { # relpath <from-dir> <to-path>
  local from="$1" to="$2" up=""
  while [ "${to#"$from"/}" = "$to" ] && [ "$from" != / ]; do
    from="$(dirname "$from")"
    up="../$up"
  done
  if [ "$from" = / ]; then printf '%s\n' "$to"; else printf '%s%s\n' "$up" "${to#"$from"/}"; fi
}

owned_link() { # owned_link <path> — a symlink resolving into HOOK_SRC
  [ -L "$1" ] || return 1
  case "$(readlink -f "$1" || true)" in "$HOOK_SRC"/*) return 0 ;; esac
  return 1
}

# slot_state <name> — absent | armed (the expected relative link) | owned (the
# suite's, but not that link) | foreign.
slot_state() {
  local dest="$HOOKS_DIR/$1"
  if [ ! -e "$dest" ] && [ ! -L "$dest" ]; then
    echo absent
  elif [ -L "$dest" ] && [ "$(readlink "$dest")" = "$(relpath "$HOOKS_DIR" "$HOOK_SRC/$1")" ]; then
    echo armed
  elif owned_link "$dest"; then
    echo owned
  else
    echo foreign
  fi
}

# hooks_prepare <wanted> — locate the hooks dir and validate the Intent's names;
# returns 1 when there is nothing to manage (no repo and no hooks wanted).
hooks_prepare() {
  local name
  if ! hooks_locate; then
    [ -z "$1" ] || die "Intent key gitHooks lists hooks but $TARGET is not a git repository"
    return 1
  fi
  for name in $1; do
    [ -f "$HOOK_SRC/$name" ] \
      || die "Intent key gitHooks lists $name, which the installed Payload doesn't ship (.claude/scripts/git-hooks/)"
  done
}

converge_git_hooks() {
  local wanted name dest reported=0
  wanted="$(intent_hooks)"
  if ! hooks_prepare "$wanted"; then
    report skipped git-hooks "none in Intent"
    return
  fi
  if [ -n "$wanted" ]; then
    mkdir -p "$HOOKS_DIR"
    hooks_locate
  fi
  for name in $wanted; do
    dest="$HOOKS_DIR/$name"
    case "$(slot_state "$name")" in
      armed) report skipped git-hooks "$name already armed" ;;
      absent)
        ln -s "$(relpath "$HOOKS_DIR" "$HOOK_SRC/$name")" "$dest"
        report done git-hooks "$name armed in $HOOKS_REL" ;;
      owned)
        rm -f "$dest"
        ln -s "$(relpath "$HOOKS_DIR" "$HOOK_SRC/$name")" "$dest"
        report done git-hooks "$name re-linked relatively in $HOOKS_REL" ;;
      foreign)
        report skipped git-hooks "$name not armed: $HOOKS_REL/$name is a foreign hook Apply won't touch; move it aside to arm the suite's" ;;
    esac
    reported=1
  done
  for dest in "$HOOKS_DIR"/*; do
    name="$(basename "$dest")"
    grep -Fxq -- "$name" <<<"$wanted" && continue
    if owned_link "$dest"; then
      rm -f "$dest"
      report done git-hooks "$name disarmed (not in Intent)"
      reported=1
    elif [ -f "$HOOK_SRC/$name" ] && [ -e "$dest" ]; then
      report skipped git-hooks "$name not in Intent; $HOOKS_REL/$name is a foreign hook, left untouched"
      reported=1
    fi
  done
  [ "$reported" -eq 1 ] || report skipped git-hooks "none in Intent"
}

check_git_hooks() {
  local wanted name dest
  wanted="$(intent_hooks)"
  hooks_prepare "$wanted" || return 0
  for name in $wanted; do
    case "$(slot_state "$name")" in
      armed) ;;
      absent) drift git-hooks "$name not armed in $HOOKS_REL" ;;
      owned) drift git-hooks "$name in $HOOKS_REL is not the expected relative link" ;;
      foreign)
        drift_manual git-hooks "$name not armed: $HOOKS_REL/$name is a foreign hook Apply won't touch; move it aside, then run /apply-claude-config" ;;
    esac
  done
  for dest in "$HOOKS_DIR"/*; do
    name="$(basename "$dest")"
    grep -Fxq -- "$name" <<<"$wanted" && continue
    owned_link "$dest" && drift git-hooks "$name armed but not in Intent"
  done
  return 0
}

# --- payload (check only) -------------------------------------------------------
# Recompute the Manifest stamp the way claude-config-install computes it, over the
# files the Manifest lists. Apply can't cure a mismatch — re-installing does.
check_payload() {
  local stamp actual
  if [ ! -f "$MANIFEST" ]; then
    report drift payload "no .claude/.claude-config-manifest; re-run claude-config-install for this Target"
    stale=1
    return
  fi
  stamp="$(sed -n 's/^# claude-config \([0-9a-f]*\)$/\1/p' "$MANIFEST" | head -n1)"
  actual="$(cd "$TARGET/.claude" && grep -v '^#' "$MANIFEST" | grep -v '^$' | LC_ALL=C sort \
    | while IFS= read -r rel; do
        if [ -f "$rel" ]; then sha256sum "$rel"; else echo "missing $rel"; fi
      done | sha256sum | cut -c1-12)"
  if [ "$actual" != "$stamp" ]; then
    report drift payload "installed files differ from the Manifest stamp ${stamp:-(none)}; re-run claude-config-install for this Target"
    stale=1
  fi
}

if [ ! -f "$INTENT" ]; then
  report skipped intent "no .claude/claude-config.json; run /setup-claude-config to create it"
  [ "$mode" = check ] && exit 3
  exit 0
fi

command -v jq >/dev/null || die "jq is required"
jq -e 'type == "object"' "$INTENT" >/dev/null 2>&1 \
  || die "cannot read Intent $INTENT: not a JSON object (or jq failed)"

if [ "$mode" = converge ]; then
  for step in "${steps[@]}"; do
    "converge_$step"
  done
  exit 0
fi

for step in "${steps[@]}"; do
  "check_$step"
done
check_payload
if [ "$drifted" -eq 1 ]; then
  report drift target "run /apply-claude-config to converge"
fi
[ "$drifted" -eq 0 ] && [ "$stale" -eq 0 ] && [ "$manual" -eq 0 ] || exit 2
exit 0
