#!/usr/bin/env bash
# Converge this Target to its Intent (.claude/claude-config.json), or check it.
# Usage: .claude/scripts/apply [--check | --refresh]   (from anywhere; the Target is found from this script's location)
#   (no flag)  converge: write the owned untracked state the Intent asks for. Never
#              writes a tracked file: Managed Block drift is only reported.
#   --check    read-only: report drift between the Target and its Intent, between
#              the installed Payload and the Manifest stamp, and in Managed Blocks.
#   --refresh  rewrite drifted Managed Blocks from the installed Payload — only between
#              their markers (see "Managed Blocks" below); nothing else is converged.
# Report: one stdout line per action, "<done|skipped|drift> <concern>: <detail>".
#   Check mode prints only drift lines (plus skipped lines for Managed Blocks it can't
#   judge), then — when converging would cure any of them —
#   "drift target: run /apply-claude-config to converge". A clean Target prints nothing.
# Exit (converge, --refresh): 0 done or nothing to do (no Intent included); 1 failure.
# Exit (--check):  0 clean; 1 failure; 2 drift; 3 no Intent (pointer to Setup printed).
# Errors go to stderr.
#
# Managed Blocks: suite-written prose in the Target's git-tracked *.md files. Each marker
# is a whole line; <id> is [a-z0-9][a-z0-9-]*, <hash> is 12 lowercase hex.
#   inline:  <!-- claude-config:begin <id> <hash> -->
#            ...block content: the lines strictly between the two markers...
#            <!-- claude-config:end <id> -->
#   seeded:  <!-- claude-config:seed <id> <hash> -->   as line 1 of a whole seeded file;
#            the content is everything after that line (inline markers there are inert).
# <hash> is the first 12 hex of sha256 over the content bytes as last written. The
# shipped content of block <id> is scripts/blocks/<id>.md in the Payload (installed
# beside this script), read with a final newline guaranteed. A block drifts when its
# content no longer matches its stamp (edited inside the markers) or its stamp no longer
# matches the shipped content (behind the Payload); either is reported with the cure,
# "/apply-claude-config refresh". Refresh rewrites a drifted block's content and stamp;
# hand-edits inside markers are overwritten, every byte outside them is kept, and a
# current block's file is not written. Deleting a block's markers (or a seed header)
# forks it out of management: check and refresh no longer see it. Blocks whose id has
# no shipped source, and files with malformed markers, are reported skipped and left
# as they are.
#
# Intent keys (a JSON object; absent keys take their default):
#   stalenessHook  boolean, default true — a SessionStart hook in .claude/settings.local.json
#                  running "apply --check" via $CLAUDE_PROJECT_DIR; false removes it.
#   gitHooks       array of hook names, default [] — each shipped hook in
#                  .claude/scripts/git-hooks/ to arm, as a relative symlink in the repo's
#                  hooks dir (core.hooksPath honoured). A suite-owned link (one resolving
#                  into .claude/scripts/git-hooks/) that the list drops is removed; a
#                  foreign hook in a slot is never touched — Apply refuses and says so.
#   plugins        array of "<plugin>@<marketplace>" strings, default [] — plugins wanted
#                  at project scope. Split scope: the enabledPlugins entry in the
#                  (possibly tracked) .claude/settings.json is shared; the plugin cache
#                  lives in each environment's ${CLAUDE_CONFIG_DIR:-~/.claude}, so each
#                  environment's own Apply run converges its cache. Apply installs via
#                  "claude plugin install --scope project" (which writes the entry),
#                  skipping with a reason when the CLI isn't on PATH. Enabled plugins the
#                  Intent doesn't list are reported for manual removal, never uninstalled.
#   model          string, default absent — the "model" settings key, written as given
#                  (an unavailable model falls back silently, so it is never probed);
#                  absent removes the key.
#   notifications  boolean, default true — false writes
#                  preferredNotifChannel: "notifications_disabled"; true removes that key.
#   permissionMode string, default "default" — permissions.defaultMode policy:
#                    "default"              removes defaultMode;
#                    "auto"                 writes defaultMode "auto" unconditionally;
#                    "auto-if-virtualised"  evaluated at Apply time: writes "auto" when this
#                                           environment is virtualised; otherwise leaves any
#                                           existing value untouched (monotone, ADR-0006).
#   statusline     boolean, default false — true writes a statusLine command that reads the
#                  statusline's stdin JSON and runs
#                  <workspace.project_dir>/.claude/scripts/statusline.sh, so no absolute
#                  path is persisted (ADR-0004); false removes statusLine.
#   mattpocock     object, default absent — not Apply's: read (and, interactively, written)
#                  by the install-mattpocock skill; Apply ignores it, as it ignores every
#                  key it doesn't list. Sub-keys:
#                    issueTracker          "local" | "github" | "gitlab" | "other"
#                    issueTrackerWorkflow  string — the workflow as prose, for "other"
#                    triageLabels          object — each of the five triage roles
#                                          (needs-triage, needs-info, ready-for-agent,
#                                          ready-for-human, wontfix) to its label string
#                    domainDocs            "single-context" | "multi-context"
#                    instructionsFile      path of the file holding the agent-skills block
#                    overlays              array of "issue-tracker-sub-efforts",
#                                          "main-flow-handback"
# Every default but stalenessHook's leaves its settings key out, so "{}" writes only the hook.
#
# Owned settings (in .claude/settings.local.json): model, preferredNotifChannel,
# permissions.defaultMode, statusLine, and the SessionStart entry running the staleness
# check. Every other key's value, including other hooks, is left as it is.
set -euo pipefail

usage() {
  echo "Usage: $0 [--check | --refresh]" >&2
  exit 1
}

mode=converge
case $# in
  0) ;;
  1) case $1 in
       --check) mode=check ;;
       --refresh) mode=refresh ;;
       *) usage ;;
     esac ;;
  *) usage ;;
esac

# Resolved fresh on every run, never persisted: Host and Sandbox mount the
# Target at different absolute paths (ADR-0009).
here="$(cd "$(dirname "$0")" && pwd)"
if [ "$(basename "$here")" != scripts ] || [ "$(basename "$(dirname "$here")")" != .claude ]; then
  echo "Error: run Apply from a Target's .claude/scripts/, not $here" >&2
  exit 1
fi
TARGET="$(cd "$here/../.." && pwd)"
INTENT="$TARGET/.claude/claude-config.json"
SETTINGS="$TARGET/.claude/settings.local.json"
MANIFEST="$TARGET/.claude/.claude-config-manifest"

report() { # report <done|skipped|drift> <concern> <detail>
  printf '%s %s: %s\n' "$1" "$2" "$3"
}

die() {
  echo "Error: $*" >&2
  exit 1
}

# drift <concern> <detail> — check mode: report drift that converging cures.
drifted=0
drift() {
  report drift "$1" "$2"
  drifted=1
}
# Check mode: set by drift reported directly (report drift ...) because converging
# can't cure it; it still makes the check exit 2, without the skill suggestion.
stale=0

# drift_manual <concern> <detail> — check mode: report drift converging won't cure
# (the detail says what the user must do); exits 2 without suggesting the skill.
manual=0
drift_manual() {
  report drift "$1" "$2"
  manual=1
}

# intent_bool <key> <default> — the Intent's boolean at top-level <key>.
intent_bool() {
  jq -r --arg k "$1" --argjson d "$2" '
    if has($k) then (if (.[$k] | type) == "boolean" then .[$k] else error("not a boolean") end)
    else $d end' "$INTENT" 2>/dev/null || die "Intent key $1 must be true or false"
}

# intent_string <key> <default> — the Intent's non-empty string at top-level <key>
# (an empty default means "absent" and prints nothing).
intent_string() {
  jq -r --arg k "$1" --arg d "$2" '
    if has($k) then (if (.[$k] | type) == "string" and .[$k] != "" then .[$k] else error("not a string") end)
    else $d end' "$INTENT" 2>/dev/null || die "Intent key $1 must be a non-empty string"
}

# settings_get <settings-json> <jq-path> — the value at <jq-path> as compact JSON,
# or nothing when absent.
settings_get() {
  jq -cS "$2 // empty" <<<"$1"
}

# Settings: Apply owns a fixed set of keys in the untracked settings.local.json;
# everything else in the file is left as it is. The file is rewritten only when a
# converge step changes something, so a converged file stays byte-identical.
settings_json() {
  if [ -f "$SETTINGS" ]; then
    jq -c . "$SETTINGS" 2>/dev/null || die "cannot read $SETTINGS: not valid JSON"
  else
    echo '{}'
  fi
}

settings_write() { # settings_write <json>
  local pretty
  pretty="$(jq . <<<"$1")"
  printf '%s\n' "$pretty" > "$SETTINGS"
}

# Each concern <c> has converge_<c> (writes, reports done/skipped) and check_<c>
# (read-only, calls drift). Both read $INTENT. Steps run in order.
steps=(staleness_hook model notifications permission_mode statusline git_hooks plugins managed_blocks)

# settings_set <jq-path> <json> / settings_del <jq-path> — write or remove one owned
# key; a parent object the removal empties is dropped too.
settings_set() {
  settings_write "$(jq -c --argjson v "$2" "$1 = \$v" <<<"$(settings_json)")"
}

settings_del() {
  local parent="${1%.*}" filter="del($1)"
  [ -n "$parent" ] && filter="$filter | if $parent == {} then del($parent) else . end"
  settings_write "$(jq -c "$filter" <<<"$(settings_json)")"
}

json_string() { jq -cn --arg v "$1" '$v'; }

# --- staleness-hook -----------------------------------------------------------
# Owned entry: the SessionStart hook whose command is exactly HOOK_CMD. The
# hooks-documented project-dir variable keeps absolute paths out of settings,
# and "|| true" keeps the session unblocked: stdout reaches the session context.
HOOK_CMD='"$CLAUDE_PROJECT_DIR"/.claude/scripts/apply --check || true'

hook_present() { # hook_present <settings-json>
  jq -e --arg cmd "$HOOK_CMD" 'any(.hooks.SessionStart[]?.hooks[]?; .command == $cmd)' <<<"$1" >/dev/null
}

converge_staleness_hook() {
  local on current
  on="$(intent_bool stalenessHook true)"
  current="$(settings_json)"
  if [ "$on" = true ]; then
    if hook_present "$current"; then
      report skipped staleness-hook "already in place"
    else
      settings_write "$(jq -c --arg cmd "$HOOK_CMD" \
        '.hooks.SessionStart += [{hooks: [{type: "command", command: $cmd}]}]' <<<"$current")"
      report done staleness-hook "SessionStart check added to .claude/settings.local.json"
    fi
  elif hook_present "$current"; then
    # Remove only the owned command; drop containers only if that emptied them.
    settings_write "$(jq -c --arg cmd "$HOOK_CMD" '
      .hooks.SessionStart |= map(
        if any(.hooks[]?; .command == $cmd)
        then (.hooks |= map(select(.command != $cmd))) | select(.hooks | length > 0)
        else . end)
      | if (.hooks.SessionStart | length) == 0 then del(.hooks.SessionStart) else . end
      | if (.hooks | length) == 0 then del(.hooks) else . end' <<<"$current")"
    report done staleness-hook "SessionStart check removed (disabled in Intent)"
  else
    report skipped staleness-hook "disabled in Intent"
  fi
}

check_staleness_hook() {
  local on current
  on="$(intent_bool stalenessHook true)"
  current="$(settings_json)"
  if [ "$on" = true ] && ! hook_present "$current"; then
    drift staleness-hook "SessionStart check missing from .claude/settings.local.json"
  elif [ "$on" = false ] && hook_present "$current"; then
    drift staleness-hook "SessionStart check present but disabled in Intent"
  fi
}

# --- plugins --------------------------------------------------------------------
# Apply never writes .claude/settings.json itself: the plugin CLI does, run from the
# Target so --scope project lands there. Installed = entry enabled and cached here.
PROJECT_SETTINGS="$TARGET/.claude/settings.json"
PLUGIN_CACHE="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/plugins/cache"

intent_plugins() { # one "<plugin>@<marketplace>" per line
  jq -r '(.plugins // []) | if type == "array" and all(type == "string" and test("^[^@\\s]+@[^@\\s]+$"))
    then .[] else error("bad plugins") end' "$INTENT" 2>/dev/null \
    || die 'Intent key plugins must be an array of "<plugin>@<marketplace>" strings'
}

enabled_plugins() { # project-scope plugins enabled in .claude/settings.json, one per line
  [ -f "$PROJECT_SETTINGS" ] || return 0
  jq -r '(.enabledPlugins // {}) | to_entries[] | select(.value == true) | .key' "$PROJECT_SETTINGS" 2>/dev/null \
    || die "cannot read $PROJECT_SETTINGS: not valid JSON"
}

plugin_cached() { # plugin_cached <plugin>@<marketplace>
  local p="$1"
  [ -n "$(ls -A "$PLUGIN_CACHE/${p#*@}/${p%@*}" 2>/dev/null)" ]
}

dropped_plugin_detail() { # dropped_plugin_detail <plugin>
  echo "$1 enabled in .claude/settings.json but not in the Intent; Apply never uninstalls — remove it by hand (claude plugin uninstall --scope project $1) or add it to the Intent"
}

# dropped_plugins <wanted> <enabled> — enabled plugins the Intent doesn't list.
dropped_plugins() {
  comm -13 <(LC_ALL=C sort -u <<<"$1") <(LC_ALL=C sort -u <<<"$2") | grep -v '^$' || true
}

converge_plugins() {
  local wanted enabled p was_enabled failed=0 missing=()
  wanted="$(intent_plugins)"
  enabled="$(enabled_plugins)"
  for p in $wanted; do
    if grep -Fxq -- "$p" <<<"$enabled" && plugin_cached "$p"; then
      report skipped plugins "$p already enabled in .claude/settings.json and cached in this environment"
    else
      missing+=("$p")
    fi
  done
  if [ "${#missing[@]}" -gt 0 ] && ! command -v claude >/dev/null; then
    report skipped plugins "claude CLI not on PATH; not installed in this environment: ${missing[*]}"
    missing=()
  fi
  for p in "${missing[@]}"; do
    was_enabled=0
    grep -Fxq -- "$p" <<<"$enabled" && was_enabled=1
    if ! (cd "$TARGET" && claude plugin install --scope project "$p") >/dev/null; then
      echo "Error: claude plugin install --scope project $p failed" >&2
      failed=1
    elif ! enabled_plugins | grep -Fxq -- "$p" || ! plugin_cached "$p"; then
      echo "Error: claude plugin install --scope project $p left it not enabled in .claude/settings.json or not cached" >&2
      failed=1
    elif [ "$was_enabled" -eq 1 ]; then
      report done plugins "$p cached in this environment (its entry was already in .claude/settings.json); each other environment caches it on its own Apply run"
    else
      report done plugins "$p enabled in .claude/settings.json (shared) and cached in this environment; each other environment caches it on its own Apply run"
    fi
  done
  while IFS= read -r p; do
    [ -n "$p" ] && report skipped plugins "$(dropped_plugin_detail "$p")"
  done <<<"$(dropped_plugins "$wanted" "$enabled")"
  [ "$failed" -eq 0 ] || die "plugin install failed (see above)"
}

check_plugins() {
  local wanted enabled p detail cli=1
  wanted="$(intent_plugins)"
  enabled="$(enabled_plugins)"
  command -v claude >/dev/null || cli=0
  for p in $wanted; do
    if ! grep -Fxq -- "$p" <<<"$enabled"; then
      detail="$p not enabled in .claude/settings.json"
    elif ! plugin_cached "$p"; then
      detail="$p enabled in .claude/settings.json but not cached in this environment"
    else
      continue
    fi
    if [ "$cli" -eq 1 ]; then
      drift plugins "$detail"
    else
      report drift plugins "$detail; claude CLI not on PATH, so Apply can't install it here"
      stale=1
    fi
  done
  # Manual removal only: drift, but converging doesn't cure it — no skill suggestion.
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    report drift plugins "$(dropped_plugin_detail "$p")"
    stale=1
  done <<<"$(dropped_plugins "$wanted" "$enabled")"
}

# --- git-hooks -------------------------------------------------------------------
# Ownership is stateless: a hooks-dir entry is the suite's when it is a symlink
# resolving into the Target's .claude/scripts/git-hooks/. Anything else in a slot is
# foreign and never modified. Links are relative, so they resolve wherever the
# Target is mounted (ADR-0009).

# intent_hooks — the Intent's gitHooks names, one per line, deduplicated.
intent_hooks() {
  jq -r 'if has("gitHooks") then .gitHooks else [] end
    | if type == "array" and all(.[]; type == "string" and test("^[a-z0-9][a-z0-9-]*$"))
      then unique[] else error("not an array of hook names") end' "$INTENT" 2>/dev/null \
    || die "Intent key gitHooks must be an array of hook names"
}

# hooks_locate — set HOOK_SRC (the installed hooks), HOOKS_DIR (the repo's hooks dir,
# core.hooksPath honoured; physical when it exists) and HOOKS_REL (HOOKS_DIR for
# reports, relative to the Target when inside it). Returns 1 outside a git repo.
hooks_locate() {
  local top dir
  top="$(cd "$TARGET" && pwd -P)"
  HOOK_SRC="$top/.claude/scripts/git-hooks"
  command -v git >/dev/null || return 1
  dir="$(cd "$TARGET" && git rev-parse --git-path hooks 2>/dev/null)" || return 1
  case $dir in /*) ;; *) dir="$top/$dir" ;; esac
  [ ! -d "$dir" ] || dir="$(cd "$dir" && pwd -P)"
  HOOKS_DIR="$dir"
  HOOKS_REL="${dir#"$top"/}"
}

relpath() { # relpath <from-dir> <to-path>
  local from="$1" to="$2" up=""
  while [ "${to#"$from"/}" = "$to" ] && [ "$from" != / ]; do
    from="$(dirname "$from")"
    up="../$up"
  done
  if [ "$from" = / ]; then printf '%s\n' "$to"; else printf '%s%s\n' "$up" "${to#"$from"/}"; fi
}

owned_link() { # owned_link <path> — a symlink resolving into HOOK_SRC
  [ -L "$1" ] || return 1
  case "$(readlink -f "$1" || true)" in "$HOOK_SRC"/*) return 0 ;; esac
  return 1
}

# slot_state <name> — absent | armed (the expected relative link) | owned (the
# suite's, but not that link) | foreign.
slot_state() {
  local dest="$HOOKS_DIR/$1"
  if [ ! -e "$dest" ] && [ ! -L "$dest" ]; then
    echo absent
  elif [ -L "$dest" ] && [ "$(readlink "$dest")" = "$(relpath "$HOOKS_DIR" "$HOOK_SRC/$1")" ]; then
    echo armed
  elif owned_link "$dest"; then
    echo owned
  else
    echo foreign
  fi
}

# hooks_prepare <wanted> — locate the hooks dir and validate the Intent's names;
# returns 1 when there is nothing to manage (no repo and no hooks wanted).
hooks_prepare() {
  local name
  if ! hooks_locate; then
    [ -z "$1" ] || die "Intent key gitHooks lists hooks but $TARGET is not a git repository"
    return 1
  fi
  for name in $1; do
    [ -f "$HOOK_SRC/$name" ] \
      || die "Intent key gitHooks lists $name, which the installed Payload doesn't ship (.claude/scripts/git-hooks/)"
  done
}

converge_git_hooks() {
  local wanted name dest reported=0
  wanted="$(intent_hooks)"
  if ! hooks_prepare "$wanted"; then
    report skipped git-hooks "none in Intent"
    return
  fi
  if [ -n "$wanted" ]; then
    mkdir -p "$HOOKS_DIR"
    hooks_locate
  fi
  for name in $wanted; do
    dest="$HOOKS_DIR/$name"
    case "$(slot_state "$name")" in
      armed) report skipped git-hooks "$name already armed" ;;
      absent)
        ln -s "$(relpath "$HOOKS_DIR" "$HOOK_SRC/$name")" "$dest"
        report done git-hooks "$name armed in $HOOKS_REL" ;;
      owned)
        rm -f "$dest"
        ln -s "$(relpath "$HOOKS_DIR" "$HOOK_SRC/$name")" "$dest"
        report done git-hooks "$name re-linked relatively in $HOOKS_REL" ;;
      foreign)
        report skipped git-hooks "$name not armed: $HOOKS_REL/$name is a foreign hook Apply won't touch; move it aside to arm the suite's" ;;
    esac
    reported=1
  done
  for dest in "$HOOKS_DIR"/*; do
    name="$(basename "$dest")"
    grep -Fxq -- "$name" <<<"$wanted" && continue
    if owned_link "$dest"; then
      rm -f "$dest"
      report done git-hooks "$name disarmed (not in Intent)"
      reported=1
    elif [ -f "$HOOK_SRC/$name" ] && [ -e "$dest" ]; then
      report skipped git-hooks "$name not in Intent; $HOOKS_REL/$name is a foreign hook, left untouched"
      reported=1
    fi
  done
  [ "$reported" -eq 1 ] || report skipped git-hooks "none in Intent"
}

check_git_hooks() {
  local wanted name dest
  wanted="$(intent_hooks)"
  hooks_prepare "$wanted" || return 0
  for name in $wanted; do
    case "$(slot_state "$name")" in
      armed) ;;
      absent) drift git-hooks "$name not armed in $HOOKS_REL" ;;
      owned) drift git-hooks "$name in $HOOKS_REL is not the expected relative link" ;;
      foreign)
        drift_manual git-hooks "$name not armed: $HOOKS_REL/$name is a foreign hook Apply won't touch; move it aside, then run /apply-claude-config" ;;
    esac
  done
  for dest in "$HOOKS_DIR"/*; do
    name="$(basename "$dest")"
    grep -Fxq -- "$name" <<<"$wanted" && continue
    owned_link "$dest" && drift git-hooks "$name armed but not in Intent"
  done
  return 0
}

# --- model ----------------------------------------------------------------------
# Written as the Intent gives it, never probed: an unavailable model falls back silently.
converge_model() {
  local want cur
  want="$(intent_string model "")"
  cur="$(settings_get "$(settings_json)" .model)"
  if [ -n "$want" ]; then
    if [ "$cur" = "$(json_string "$want")" ]; then
      report skipped model "already $want"
    else
      settings_set .model "$(json_string "$want")"
      report done model "set to $want"
    fi
  elif [ -n "$cur" ]; then
    settings_del .model
    report done model "removed $cur (absent from Intent)"
  else
    report skipped model "absent from Intent"
  fi
}

check_model() {
  local want cur
  want="$(intent_string model "")"
  cur="$(settings_get "$(settings_json)" .model)"
  if [ -n "$want" ] && [ "$cur" != "$(json_string "$want")" ]; then
    drift model "is ${cur:-unset}, Intent wants $(json_string "$want")"
  elif [ -z "$want" ] && [ -n "$cur" ]; then
    drift model "is $cur but absent from Intent"
  fi
}

# --- notifications ----------------------------------------------------------------
NOTIF_OFF='"notifications_disabled"'

converge_notifications() {
  local on cur
  on="$(intent_bool notifications true)"
  cur="$(settings_get "$(settings_json)" .preferredNotifChannel)"
  if [ "$on" = false ]; then
    if [ "$cur" = "$NOTIF_OFF" ]; then
      report skipped notifications "already disabled"
    else
      settings_set .preferredNotifChannel "$NOTIF_OFF"
      report done notifications "disabled (preferredNotifChannel $NOTIF_OFF)"
    fi
  elif [ -n "$cur" ]; then
    settings_del .preferredNotifChannel
    report done notifications "enabled (preferredNotifChannel $cur removed)"
  else
    report skipped notifications "already enabled"
  fi
}

check_notifications() {
  local on cur
  on="$(intent_bool notifications true)"
  cur="$(settings_get "$(settings_json)" .preferredNotifChannel)"
  if [ "$on" = false ] && [ "$cur" != "$NOTIF_OFF" ]; then
    drift notifications "preferredNotifChannel is ${cur:-unset}, Intent wants $NOTIF_OFF"
  elif [ "$on" = true ] && [ -n "$cur" ]; then
    drift notifications "preferredNotifChannel is $cur but Intent leaves notifications on"
  fi
}

# --- permission-mode ----------------------------------------------------------------
# The virtualisation gate (ADR-0006), evaluated here, in this run's environment. It
# answers only yes or no. systemd-detect-virt is authoritative when installed (it covers
# VMs and containers alike); the file, env and DMI probes stand in only without it.
virtualised() {
  local virt vendor
  if command -v systemd-detect-virt >/dev/null 2>&1; then
    virt="$(systemd-detect-virt 2>/dev/null)" && [ -n "$virt" ] && [ "$virt" != none ]
    return
  fi
  [ -e /run/.containerenv ] || [ -e /.dockerenv ] || [ -n "${container:-}" ] && return 0
  vendor="$(cat /sys/class/dmi/id/sys_vendor 2>/dev/null || true)"
  grep -Eqi 'qemu|kvm|vmware|virtualbox|xen|microsoft|parallels|bochs' <<<"$vendor"
}

# permission_want — the defaultMode the policy asks for in this environment: "auto",
# "" (remove), or "keep" (negative gate: leave whatever is there).
permission_want() {
  local policy
  policy="$(intent_string permissionMode default)"
  case "$policy" in
    default) echo "" ;;
    auto) echo auto ;;
    auto-if-virtualised) if virtualised; then echo auto; else echo keep; fi ;;
    *) die "Intent key permissionMode must be default, auto or auto-if-virtualised, not $policy" ;;
  esac
}

converge_permission_mode() {
  local policy want cur
  policy="$(intent_string permissionMode default)"
  want="$(permission_want)"
  cur="$(settings_get "$(settings_json)" .permissions.defaultMode)"
  case "$want" in
    auto)
      if [ "$cur" = '"auto"' ]; then
        report skipped permission-mode "already auto (Intent policy $policy)"
      else
        settings_set .permissions.defaultMode '"auto"'
        report done permission-mode "defaultMode set to auto (Intent policy $policy)"
      fi ;;
    keep)
      report skipped permission-mode "not virtualised; defaultMode left ${cur:-unset} (Intent policy $policy)" ;;
    *)
      if [ -n "$cur" ]; then
        settings_del .permissions.defaultMode
        report done permission-mode "defaultMode $cur removed (Intent policy $policy)"
      else
        report skipped permission-mode "defaultMode unset (Intent policy $policy)"
      fi ;;
  esac
}

check_permission_mode() {
  local policy want cur
  policy="$(intent_string permissionMode default)"
  want="$(permission_want)"
  cur="$(settings_get "$(settings_json)" .permissions.defaultMode)"
  if [ "$want" = auto ] && [ "$cur" != '"auto"' ]; then
    drift permission-mode "defaultMode is ${cur:-unset}, Intent policy $policy wants \"auto\" here"
  elif [ -z "$want" ] && [ -n "$cur" ]; then
    drift permission-mode "defaultMode is $cur but Intent policy is $policy"
  fi
}

# --- statusline -------------------------------------------------------------------
# Resolved at render time from the statusline's documented stdin JSON, so the persisted
# command holds no absolute path and works on the Host and in a Sandbox alike (ADR-0004).
STATUS_CMD="$(cat <<'EOF'
input=$(cat); dir=$(printf '%s' "$input" | jq -r '.workspace.project_dir // empty'); [ -n "$dir" ] && printf '%s' "$input" | bash "$dir/.claude/scripts/statusline.sh"
EOF
)"
STATUS_JSON="$(jq -cnS --arg cmd "$STATUS_CMD" '{type: "command", command: $cmd}')"

converge_statusline() {
  local on cur
  on="$(intent_bool statusline false)"
  cur="$(settings_get "$(settings_json)" .statusLine)"
  if [ "$on" = true ]; then
    if [ "$cur" = "$STATUS_JSON" ]; then
      report skipped statusline "already in place"
    else
      settings_set .statusLine "$STATUS_JSON"
      report done statusline "render-time command for .claude/scripts/statusline.sh set"
    fi
  elif [ -n "$cur" ]; then
    settings_del .statusLine
    report done statusline "statusLine removed (disabled in Intent)"
  else
    report skipped statusline "disabled in Intent"
  fi
}

check_statusline() {
  local on cur
  on="$(intent_bool statusline false)"
  cur="$(settings_get "$(settings_json)" .statusLine)"
  if [ "$on" = true ] && [ "$cur" != "$STATUS_JSON" ]; then
    if [ -n "$cur" ]; then
      drift statusline "statusLine differs from the render-time command"
    else
      drift statusline "statusLine missing from .claude/settings.local.json"
    fi
  elif [ "$on" = false ] && [ -n "$cur" ]; then
    drift statusline "statusLine present but disabled in Intent"
  fi
}

# --- managed-blocks -------------------------------------------------------------
# Grammar and lifecycle in the header. Converge and check only report; the cure is
# the explicit refresh, so check counts block drift as drift converging can't cure.
BLOCKS="$here/blocks"
REFRESH_STEP='run /apply-claude-config refresh'

sha12() { sha256sum | cut -c1-12; }

# blocks_parse <file> — one record per line: "seed <id> <stamp>",
# "block <begin-line> <end-line> <id> <stamp>", or "bad <line> <reason>".
blocks_parse() {
  LC_ALL=C awk -v idre='^[a-z0-9][a-z0-9-]*$' -v hre="^$(printf '[0-9a-f]%.0s' {1..12})\$" '
    function bad(msg, line) { print "bad", line ? line : NR, msg }
    seeded || !/^<!-- claude-config:(begin|end|seed)( |$)/ { next }
    {
      kind = substr($2, 15)
      if (kind == "seed") {
        if (!(NF == 5 && $3 ~ idre && $4 ~ hre && $0 == "<!-- claude-config:seed " $3 " " $4 " -->")) bad("malformed seed header")
        else if (NR != 1) bad("seed header " $3 " not on the first line")
        else { print "seed", $3, $4; seeded = 1 }
      } else if (kind == "begin") {
        if (!(NF == 5 && $3 ~ idre && $4 ~ hre && $0 == "<!-- claude-config:begin " $3 " " $4 " -->")) bad("malformed begin marker")
        else if (open != "") bad("block " $3 " begins inside block " open)
        else { open = $3; stamp = $4; start = NR }
      } else if (!(NF == 4 && $3 ~ idre && $0 == "<!-- claude-config:end " $3 " -->")) bad("malformed end marker")
      else if (open == "") bad("block " $3 " ends without a begin marker")
      else if ($3 != open) bad("end marker " $3 " closes block " open)
      else { print "block", start, NR, open, stamp; open = "" }
    }
    END { if (open != "") bad("block " open " never ends", start) }' "$1"
}

# blocks_rewrite <file> <plan> — replace the content of each planned block, keyed by
# "<begin-line>\t<end-line>\t<id>\t<stamp>\t<source>" plan lines; other bytes kept.
blocks_rewrite() {
  local file="$1" tmp
  tmp="$(mktemp)"
  LC_ALL=C awk -F '\t' '
    FNR == NR { end[$1] = $2; id[$1] = $3; stamp[$1] = $4; src[$1] = $5; next }
    skip && FNR < skip { next }
    skip { skip = 0; print; next }
    FNR in end {
      print "<!-- claude-config:begin " id[FNR] " " stamp[FNR] " -->"
      while ((getline line < src[FNR]) > 0) print line
      close(src[FNR])
      skip = end[FNR]
      next
    }
    { print }' - "$file" <<<"$2" > "$tmp"
  # awk ends every line with a newline; keep a missing final one missing.
  if [ -n "$(tail -c1 "$file")" ]; then
    head -c -1 "$tmp" > "$file"
  else
    cat "$tmp" > "$file"
  fi
  rm -f "$tmp"
}

# managed_blocks <converge|check|refresh> — walk every Managed Block in tracked markdown.
managed_blocks() {
  local mode="$1" rel file parsed kind a b id stamp src actual want label state plan
  local found=0 current=0
  while IFS= read -r -d '' rel; do
    file="$TARGET/$rel"
    [ -f "$file" ] || continue
    parsed="$(blocks_parse "$file")" || die "cannot read $rel"
    [ -n "$parsed" ] || continue
    if read -r _ a b <<<"$(grep '^bad ' <<<"$parsed" | head -n1)" && [ -n "$a" ]; then
      report skipped managed-blocks "$rel: line $a: $b; markers left as they are"
      continue
    fi
    plan=""
    while read -r kind a b id stamp; do
      if [ "$kind" = seed ]; then
        id="$a" stamp="$b" label="seeded block $a"
        actual="$(tail -n +2 "$file" | sha12)"
      else
        label="block $id"
        if [ "$b" -gt $((a + 1)) ]; then
          actual="$(sed -n "$((a + 1)),$((b - 1))p" "$file" | sha12)"
        else
          actual="$(printf '' | sha12)"
        fi
      fi
      found=$((found + 1))
      src="$BLOCKS/$id.md"
      if [ ! -f "$src" ]; then
        report skipped managed-blocks "$rel: $label has no shipped source; left as it is (delete its markers to fork it)"
        continue
      fi
      want="$(awk 1 "$src" | sha12)"
      if [ "$actual" != "$stamp" ]; then state=edited
      elif [ "$stamp" != "$want" ]; then state=behind
      else state=current
      fi
      if [ "$state" = current ]; then
        current=$((current + 1))
        [ "$mode" = refresh ] && report skipped managed-blocks "$rel: $label current"
        continue
      fi
      if [ "$mode" != refresh ]; then
        if [ "$state" = edited ]; then
          report drift managed-blocks "$rel: $label edited inside its markers; $REFRESH_STEP to rewrite it (overwrites those edits)"
        else
          report drift managed-blocks "$rel: $label behind the Payload; $REFRESH_STEP to rewrite it"
        fi
        stale=1
        continue
      fi
      if [ "$kind" = seed ]; then
        { printf '<!-- claude-config:seed %s %s -->\n' "$id" "$want"; awk 1 "$src"; } > "$file"
      else
        plan+="$a"$'\t'"$b"$'\t'"$id"$'\t'"$want"$'\t'"$src"$'\n'
      fi
      if [ "$state" = edited ]; then
        report done managed-blocks "$rel: $label refreshed from the Payload (edits inside its markers overwritten)"
      else
        report done managed-blocks "$rel: $label refreshed from the Payload"
      fi
    done < <(grep -v '^bad ' <<<"$parsed")
    [ -z "$plan" ] || blocks_rewrite "$file" "${plan%$'\n'}"
  done < <(cd "$TARGET" && git ls-files -z -- '*.md' 2>/dev/null \
    | xargs -0 -r grep -lZE '^<!-- claude-config:(begin|end|seed)( |$)' -- 2>/dev/null)
  if [ "$mode" != check ] && [ "$found" -eq 0 ]; then
    report skipped managed-blocks "no Managed Blocks in tracked markdown"
  elif [ "$mode" = converge ] && [ "$current" -gt 0 ]; then
    report skipped managed-blocks "$current block(s) current"
  fi
}

converge_managed_blocks() { managed_blocks converge; }
check_managed_blocks() { managed_blocks check; }

# --- payload (check only) -------------------------------------------------------
# Recompute the Manifest stamp the way claude-config-install computes it, over the
# files the Manifest lists. Apply can't cure a mismatch — re-installing does.
check_payload() {
  local stamp actual
  if [ ! -f "$MANIFEST" ]; then
    report drift payload "no .claude/.claude-config-manifest; re-run claude-config-install for this Target"
    stale=1
    return
  fi
  stamp="$(sed -n 's/^# claude-config \([0-9a-f]*\)$/\1/p' "$MANIFEST" | head -n1)"
  actual="$(cd "$TARGET/.claude" && grep -v '^#' "$MANIFEST" | grep -v '^$' | LC_ALL=C sort \
    | while IFS= read -r rel; do
        if [ -f "$rel" ]; then sha256sum "$rel"; else echo "missing $rel"; fi
      done | sha256sum | cut -c1-12)"
  if [ "$actual" != "$stamp" ]; then
    report drift payload "installed files differ from the Manifest stamp ${stamp:-(none)}; re-run claude-config-install for this Target"
    stale=1
  fi
}

if [ ! -f "$INTENT" ]; then
  report skipped intent "no .claude/claude-config.json; run /setup-claude-config to create it"
  [ "$mode" = check ] && exit 3
  exit 0
fi

command -v jq >/dev/null || die "jq is required"
jq -e 'type == "object"' "$INTENT" >/dev/null 2>&1 \
  || die "cannot read Intent $INTENT: not a JSON object (or jq failed)"

if [ "$mode" = refresh ]; then
  managed_blocks refresh
  exit 0
fi

if [ "$mode" = converge ]; then
  for step in "${steps[@]}"; do
    "converge_$step"
  done
  exit 0
fi

for step in "${steps[@]}"; do
  "check_$step"
done
check_payload
if [ "$drifted" -eq 1 ]; then
  report drift target "run /apply-claude-config to converge"
fi
[ "$drifted" -eq 0 ] && [ "$stale" -eq 0 ] && [ "$manual" -eq 0 ] || exit 2
exit 0
